{
  "api_tokens": [
    {
      "name": "xiaoju-action-create-read",
      "token": "replace-with-xiaoju-action-secret",
      "scope": ["jobs:read", "jobs:create"]
    },
    {
      "name": "tim-local-operator",
      "token": "replace-with-operator-secret",
      "scope": ["jobs:read", "jobs:create", "jobs:approve", "jobs:run"]
    },
    {
      "name": "station1-worker",
      "token": "replace-with-station1-worker-secret",
      "scope": ["station-jobs:claim", "station-jobs:result"]
    },
    {
      "name": "xiaoju-command-channel",
      "token": "replace-with-xiaoju-command-channel-secret",
      "scope": ["remote-jobs:create", "remote-jobs:read", "remote-jobs:list"]
    },
    {
      "name": "cloud-readonly-worker",
      "token": "replace-with-cloud-readonly-worker-secret",
      "scope": ["remote-jobs:claim", "remote-jobs:result"]
    }
  ]
}
